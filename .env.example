# AgentLabs runs fully offline by default (deterministic mock provider, simulated LoRA).

# LLM provider: "mock" (default, free, deterministic) or "openai" (any OpenAI-compatible API).
AGENTLABS_LLM_PROVIDER=mock
# Only used when AGENTLABS_LLM_PROVIDER=openai.
OPENAI_API_KEY=
# Leave empty for api.openai.com. Examples: https://openrouter.ai/api/v1, https://api.deepseek.com
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Where the SQLite database and exported artifacts are stored.
AGENTLABS_DATA_DIR=.agentlabs

# LoRA lab: comma-separated local Hugging Face model directories (needs backend/requirements-ml.txt).
AGENTLABS_LOCAL_MODEL_PATHS=
AGENTLABS_ALLOW_REAL_TRAINING=true
