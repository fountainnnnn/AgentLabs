{
  "name": "agentforge",
  "version": "0.1.0",
  "description": "Agent hardening and evaluation system - pre-hackathon foundation",
  "private": true,
  "scripts": {
    "test": "npx playwright test --config=tests/playwright/playwright.config.ts",
    "test:ui": "npx playwright test --ui --config=tests/playwright/playwright.config.ts",
    "setup": "cd backend && pip install -r requirements.txt && cd ../agentforge-react && npm install",
    "dev:backend": "cd backend && python -m uvicorn main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:frontend": "cd agentforge-react && npm run dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "playwright": "^1.59.1"
  }
}
